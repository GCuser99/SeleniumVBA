	"debugConsoleEntryHistory": [
		"run est",
		"print App.modulepath",
		"app.lastbuildpath",
		"print app.lastbuildpath",
		"print app.path",
		"print ${SourcePath}",
		"print osKeyMapper(keyString)",
		"print &HE008&",
		"print &HE008",
		"ChrW$(&HE008&)",
		"print ChrW$(&HE008&)",
		"print environ(\"USERPROFILE\")",
		"print Format$(1000, \"#,#\")",
		"print htmlDoc.documentMode",
		"print chr$(34)",
		"print commandstr",
		"print callerApplicationObject=nothing",
		"print app.Build",
		"print app.isinide",
		"print \"<?xml version=\" & Chr$(34) & \"1.0\" & Chr$(34) & \"?>\" _                 & \"<xsl:stylesheet version=\" & Chr$(34) & \"1.0\" & Chr$(34) _                 & \"                xmlns:xsl=\" & Chr$(34) & \"http://www.w3.org/1999/XSL/Transform\" & Chr$(34) & \">\" _                 & \"<xsl:strip-space elements=\" & Chr$(34) & \"*\" & Chr$(34) & \" />\" _                 & \"<xsl:output method=\" & Chr$(34) & \"xml\" & Chr$(34) & \" indent=\" & Chr$(34) & \"yes\" & Chr$(34) & vbNullString _                 & \"            encoding=\" & Chr$(34) & \"UTF-8\" & Chr$(34) & \"/>\" _                 & \" <xsl:template match=\" & Chr$(34) & \"node() | @*\" & Chr$(34) & \">\" _                 & \"  <xsl:copy>\" _                 & \"   <xsl:apply-templates select=\" & Chr$(34) & \"node() | @*\" & Chr$(34) & \" />\" _                 & \"  </xsl:copy>\" _                 & \" </xsl:template>\" _                 & \"</xsl:stylesheet>\"",
		"print len(json_String)",
